# URL de base de l'API backend
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Affiche les 5 boutons de connexion rapide (comptes de démonstration) dans la
# modale de connexion. À ne JAMAIS mettre à "true" en production : ces comptes
# ont des identifiants réels visibles dans le bundle JS envoyé au navigateur.
NEXT_PUBLIC_ENABLE_DEMO_ACCOUNTS=false
